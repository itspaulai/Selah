    <!-- About / Privacy -->
    <string name="about_title">About Selah</string>
    <string name="about_body">Selah is a calm, open-source daily scripture app built for privacy and focus.\n\n• 100% offline — no internet permission required\n• No accounts, no tracking, no ads\n• Public domain translations: World English Bible (WEB), King James Version (KJV), American Standard Version (ASV), Bible in Basic English (BBE), Louis Segond 1910 (LSG), and Bulgarian Bible 1940 (ББ40)\n• Automatic daily widget updates with Material You dynamic colors</string>

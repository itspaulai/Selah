<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_tonal">

    <ImageView
        android:id="@+id/widget_text_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_verse_text_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/newsreader"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.92"
                android:text="The Lord is my shepherd; I shall lack nothing."
                android:textColor="@color/widget_text_primary"
                android:textSize="13.5dp"
                android:visibility="gone"
                tools:ignore="SpUsage"
                tools:targetApi="o" />

            <TextView
                android:id="@+id/widget_verse_text_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/google_sans_flex"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.92"
                android:text="The Lord is my shepherd; I shall lack nothing."
                android:textColor="@color/widget_text_primary"
                android:textSize="13dp"
                tools:ignore="SpUsage"
                tools:targetApi="o" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_reference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans_flex"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Psalm 23:1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11dp"
            android:textStyle="bold"
            tools:ignore="SpUsage"
            tools:targetApi="o" />
    </LinearLayout>
</FrameLayout>
